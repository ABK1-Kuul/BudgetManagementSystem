<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.smartbudget.controllers.BudgetController">
    <top>
        <HBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Budget" style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Back to Dashboard" onAction="#onBackClick" style="-fx-font-size: 12; -fx-padding: 8;" />
        </HBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 50;">
            <Label text="Budget Screen" style="-fx-font-size: 24; -fx-font-weight: bold;" />
            <Label text="(Week 3 Implementation - Coming Soon)" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" />
        </VBox>
    </center>
</BorderPane>

